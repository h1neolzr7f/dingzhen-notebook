# All paths are relative to the project root. Do not put credentials here.
FENBI_DATA_DIR=./data
FENBI_EXPORT_DIR=./exports

# Offline by default. Install requirements-ocr.txt before selecting paddle.
FENBI_OCR_ENGINE=mock
FENBI_OCR_LANGUAGE=ch
FENBI_OCR_MIN_CONFIDENCE=0.85

# P6 stability defaults (the JSON file is the source of truth for profiles).
FENBI_STABILITY_CONFIG=./config/stability.json
FENBI_UPDATE_CONFIG=./config/update.json

# Optional local AI endpoint; no API key/cookie/token is accepted by the adapter.
FENBI_AI_MODEL=mock-p5
FENBI_AI_CACHE_DIR=./exports/ai-cache
FENBI_AI_HTTP_ENDPOINT=http://127.0.0.1:11434/api/generate
